# Keep project targets here; the shared targets come from the selected
# asta-plugins version. Track workspace.mk to take ownership of them.
# Keep .asta/cache/ ignored; remove it to fetch managed files again.
# A tracked workspace.mk is a project-owned override, including its check target.
# Bare clean only removes local Quarto output and works before the first fetch.
# Other goals load the managed targets; add project cleanup as prerequisites.
# The selected asta-plugins ref supplies executable Make rules. Choose a
# release ref in docs.yml to control upgrades, or track a moving ref deliberately.
# Without docs.yml, the newest final release tag supplies those rules.
.DEFAULT_GOAL := workspace-assets
ASTA_LOCAL_MK := $(shell git ls-files --error-unmatch workspace.mk 2>/dev/null)
ASTA_DOCS_REF := $(shell awk '/^[[:space:]]*uses:[[:space:]]*/ && /allenai\/asta-plugins\/\.github\/workflows\/workspace-quarto-site\.yml@/ { sub(/^.*workspace-quarto-site\.yml@/, ""); sub(/[^A-Za-z0-9._\/-].*$$/, ""); print; exit }' .github/workflows/docs.yml 2>/dev/null)
ifneq ($(ASTA_LOCAL_MK),)
ifeq ($(wildcard workspace.mk),)
$(error workspace.mk is tracked but missing; restore it or remove it from Git)
endif
ifndef ASTA_PLUGINS_REF
ASTA_PLUGINS_REF := $(ASTA_DOCS_REF)
endif
include workspace.mk
else
ifneq ($(MAKECMDGOALS),)
ifeq ($(filter-out clean,$(MAKECMDGOALS)),)
# Offline cleanup intentionally removes only local Quarto build output.
.PHONY: clean
clean:
	rm -rf _site .quarto
else
ASTA_LOAD_WORKSPACE_MK := 1
endif
else
ASTA_LOAD_WORKSPACE_MK := 1
endif

ifeq ($(ASTA_LOAD_WORKSPACE_MK),1)
ifneq ($(shell git rev-parse --is-inside-work-tree 2>/dev/null),)
ifeq ($(shell git check-ignore -q .asta/cache/ && echo ignored),)
$(error Add .asta/cache/ to .gitignore before using the managed Makefile)
endif
endif
ASTA_REF_ORIGIN := $(origin ASTA_PLUGINS_REF)
ifneq ($(origin ASTA_PLUGINS_REF),undefined)
override ASTA_PLUGINS_REF := $(value ASTA_PLUGINS_REF)
endif
ifeq ($(ASTA_REF_ORIGIN),environment)
$(warning ASTA_PLUGINS_REF from the environment overrides docs.yml; local builds may differ from CI)
endif
ASTA_PLUGINS_REPO ?= https://github.com/allenai/asta-plugins
ASTA_PLUGINS_ARCHIVE_URL ?=
ASTA_CACHE_ROOT := .asta/cache
ifneq ($(value ASTA_PLUGINS_REPO),https://github.com/allenai/asta-plugins)
ASTA_CUSTOM_SOURCE := 1
endif
ifneq ($(value ASTA_PLUGINS_ARCHIVE_URL),)
ASTA_CUSTOM_SOURCE := 1
endif
ifeq ($(ASTA_CUSTOM_SOURCE),1)
ASTA_SOURCE_ID := $(shell printf '%s\n%s\n' '$(subst ','"'"',$(value ASTA_PLUGINS_REPO))' '$(subst ','"'"',$(value ASTA_PLUGINS_ARCHIVE_URL))' | git hash-object --stdin | cut -c 1-12)
ASTA_CACHE_ROOT := .asta/cache/sources/$(ASTA_SOURCE_ID)
endif
ifndef ASTA_PLUGINS_REF
ASTA_PLUGINS_REF := $(ASTA_DOCS_REF)
endif
ifeq ($(strip $(ASTA_PLUGINS_REF)),)
ifneq ($(wildcard .github/workflows/docs.yml),)
$(error Cannot read the asta-plugins workflow ref from docs.yml; fix it or set ASTA_PLUGINS_REF explicitly)
endif
ASTA_DEFAULT_RELEASE := 1
ASTA_CACHED_RELEASE := $(shell ref=$$(cat '$(ASTA_CACHE_ROOT)/default-release' 2>/dev/null); printf '%s\n' "$$ref" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$$' && [ -s '$(ASTA_CACHE_ROOT)'/"$$ref"/workspace.mk ] && printf '%s' "$$ref")
ASTA_LAST_CACHED_RELEASE := $(shell find $(ASTA_CACHE_ROOT) -mindepth 2 -maxdepth 2 -type f -name workspace.mk -size +0c ! -exec sh -c 'head -n 1 "$$1" | grep -Eq "^(# asta-fallback|override ASTA_PLUGINS_REF := )"' _ {} \; -print 2>/dev/null | awk -F/ '{ ref = $$(NF-1); if (ref ~ /^v[0-9]+\.[0-9]+\.[0-9]+$$/) print ref }' | sort -V | tail -n 1)
ifneq ($(ASTA_CACHED_RELEASE),)
ifneq ($(shell find $(ASTA_CACHE_ROOT)/default-release -mmin -60 -type f -print 2>/dev/null),)
ASTA_PLUGINS_REF := $(ASTA_CACHED_RELEASE)
endif
endif
ifeq ($(strip $(ASTA_PLUGINS_REF)),)
ASTA_PLUGINS_REF := $(shell repo='$(subst ','"'"',$(value ASTA_PLUGINS_REPO))'; if command -v timeout >/dev/null 2>&1; then limit=timeout; elif command -v gtimeout >/dev/null 2>&1; then limit=gtimeout; else limit=; fi; if [ -n "$$limit" ]; then GIT_TERMINAL_PROMPT=0 GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=5 GIT_SSH_COMMAND='ssh -o ConnectTimeout=5 -o ServerAliveInterval=5 -o ServerAliveCountMax=1' "$$limit" 15 git ls-remote --tags --refs "$$repo" 'v*' 2>/dev/null; else GIT_TERMINAL_PROMPT=0 GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=5 GIT_SSH_COMMAND='ssh -o ConnectTimeout=5 -o ServerAliveInterval=5 -o ServerAliveCountMax=1' git ls-remote --tags --refs "$$repo" 'v*' 2>/dev/null; fi | awk -F/ '{print $$NF}' | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$$' | sort -V | tail -n 1)
ifeq ($(ASTA_PLUGINS_REF),$(ASTA_CACHED_RELEASE))
$(shell touch $(ASTA_CACHE_ROOT)/default-release)
endif
endif
ifeq ($(strip $(ASTA_PLUGINS_REF)),)
ASTA_PLUGINS_REF := $(ASTA_CACHED_RELEASE)
ifeq ($(strip $(ASTA_PLUGINS_REF)),)
ASTA_PLUGINS_REF := $(ASTA_LAST_CACHED_RELEASE)
endif
ifneq ($(strip $(ASTA_PLUGINS_REF)),)
$(warning Cannot look up asta-plugins releases; using cached $(ASTA_PLUGINS_REF))
endif
endif
endif

ifneq ($(wildcard workspace.mk),)
$(warning workspace.mk is untracked; commit it to use it as a local override)
endif
ifeq ($(strip $(ASTA_PLUGINS_REF)),)
$(error Cannot find an asta-plugins release ref; set ASTA_PLUGINS_REF explicitly)
endif
ifneq ($(findstring ..,$(ASTA_PLUGINS_REF)),)
$(error Invalid asta-plugins ref: $(ASTA_PLUGINS_REF))
endif
ifneq ($(filter /%,$(ASTA_PLUGINS_REF)),)
$(error Invalid asta-plugins ref: $(ASTA_PLUGINS_REF))
endif
define ASTA_NEWLINE


endef
ifneq ($(findstring $(ASTA_NEWLINE),$(ASTA_PLUGINS_REF)),)
$(error Invalid asta-plugins ref: line breaks are not allowed)
endif
ifneq ($(shell printf '%s\n' '$(subst ','"'"',$(ASTA_PLUGINS_REF))' | LC_ALL=C awk 'NR != 1 || $$0 !~ /^[A-Za-z0-9_./-]+$$/ { invalid = 1 } { n = split($$0, part, "/"); if (part[1] == "sources" || part[1] == "default-release") invalid = 1; for (i = 1; i <= n; i++) if (part[i] == "" || part[i] == ".") invalid = 1 } END { if (NR == 1 && !invalid) print "valid" }'),valid)
$(error Invalid asta-plugins ref: $(ASTA_PLUGINS_REF))
endif
ASTA_WORKSPACE_MK := $(ASTA_CACHE_ROOT)/$(ASTA_PLUGINS_REF)/workspace.mk
ASTA_REQUESTED_REF := $(ASTA_PLUGINS_REF)
ASTA_FALLBACK_RELEASE := $(or $(ASTA_CACHED_RELEASE),$(ASTA_LAST_CACHED_RELEASE))
include $(ASTA_WORKSPACE_MK)

.PHONY: workspace-check-gate
check: workspace-check-gate
workspace-check-gate:
	@test "$(origin ASTA_WORKSPACE_CHECK)" = file && test "$(ASTA_WORKSPACE_CHECK)" = 1 || { echo "selected workspace.mk does not provide the shared check gate" >&2; exit 1; }

# Moving refs and failed fetches retry at most once an hour. A failed refresh
# keeps the last working copy so local work can continue offline.
ifneq ($(shell head -n 1 '$(ASTA_WORKSPACE_MK)' 2>/dev/null | grep -E '^(# asta-fallback|override ASTA_PLUGINS_REF := )'),)
ifeq ($(shell find $(ASTA_WORKSPACE_MK) -mmin -60 -type f -print 2>/dev/null),)
ifeq ($(MAKE_RESTARTS),)
.PHONY: workspace-ref-check
workspace-ref-check: ;
$(ASTA_WORKSPACE_MK): workspace-ref-check
endif
endif
else ifeq ($(shell printf '%s\n' '$(subst ','"'"',$(ASTA_PLUGINS_REF))' | grep -Eq '^(v[0-9]+\.[0-9]+\.[0-9]+|[0-9a-fA-F]{40})$$' && echo immutable),)
ifeq ($(shell find $(ASTA_WORKSPACE_MK) -mmin -60 -type f -print 2>/dev/null),)
.PHONY: workspace-ref-check
workspace-ref-check: ;
$(ASTA_WORKSPACE_MK): workspace-ref-check
endif
endif

# Retain old archives for a day so concurrent builds can finish using them.
$(ASTA_WORKSPACE_MK):
	@set -eu; \
	ref='$(ASTA_REQUESTED_REF)'; \
	case "$$ref" in *[!A-Za-z0-9_./-]*|*..*|/*) echo "invalid asta-plugins ref: $$ref" >&2; exit 1;; esac; \
	url='$(subst ','"'"',$(value ASTA_PLUGINS_ARCHIVE_URL))'; \
	if [ -z "$$url" ]; then \
		if printf '%s\n' "$$ref" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$$'; then \
			url='$(subst ','"'"',$(value ASTA_PLUGINS_REPO))/archive/refs/tags/'"$$ref"'.tar.gz'; \
		elif [ "$$ref" = latest ] || [ "$$ref" = main ]; then \
			url='$(subst ','"'"',$(value ASTA_PLUGINS_REPO))/archive/refs/heads/'"$$ref"'.tar.gz'; \
		else \
			url='$(subst ','"'"',$(value ASTA_PLUGINS_REPO))/archive/'"$$ref"'.tar.gz'; \
		fi; \
	fi; \
	mkdir -p '$(ASTA_CACHE_ROOT)'; tmp=$$(mktemp -d '$(ASTA_CACHE_ROOT)/.tmp.XXXXXX'); trap 'rm -rf "$$tmp"' EXIT; trap 'exit 1' HUP INT TERM; \
	failure="workspace: cannot fetch managed Makefile from $$url"; \
	if curl -fsSL --connect-timeout 5 --max-time 120 "$$url" -o "$$tmp/archive.tar.gz"; then \
		failure="workspace: invalid managed Makefile archive from $$url"; \
		if tar -tzf "$$tmp/archive.tar.gz" >/dev/null 2>&1; then \
			entry=$$(tar -tzf "$$tmp/archive.tar.gz" | grep -E '^(\./)?[^/]*/plugins/asta-tools/skills/workspace/assets/workspace\.mk$$' | head -n 1) || :; \
			if [ -z "$$entry" ]; then \
				failure="workspace: $$ref does not provide a managed workspace.mk; choose a newer ref or commit a custom workspace.mk"; \
			elif tar -xzOf "$$tmp/archive.tar.gz" "$$entry" > "$$tmp/workspace.mk" && [ -s "$$tmp/workspace.mk" ]; then \
				mkdir -p "$$(dirname "$@")"; \
				archive_path="$(@D)/archive-$$(git hash-object "$$tmp/archive.tar.gz").tar.gz"; \
				printf 'override ASTA_WORKSPACE_ARCHIVE := %s\n' "$$archive_path" > "$$tmp/managed.mk"; \
				cat "$$tmp/workspace.mk" >> "$$tmp/managed.mk"; \
				mv "$$tmp/archive.tar.gz" "$$archive_path"; \
				mv "$$tmp/managed.mk" "$@"; \
				echo "workspace: loaded managed Makefile for $$ref" >&2; \
				find "$(@D)" -maxdepth 1 -type f -name 'archive-*.tar.gz' -mmin +1440 ! -path "$$archive_path" -delete || echo 'workspace: could not prune old archives' >&2; \
				if [ "$(ASTA_DEFAULT_RELEASE)" = 1 ]; then \
					ref_file=$$(mktemp '$(ASTA_CACHE_ROOT)/.default-release.XXXXXX'); \
					printf '%s\n' "$$ref" > "$$ref_file"; mv "$$ref_file" '$(ASTA_CACHE_ROOT)/default-release'; \
				fi; \
				exit 0; \
			fi; \
		fi; \
	fi; \
	if [ -s "$@" ]; then touch "$@"; echo "workspace: using cached Makefile; refresh failed ($$failure)" >&2; exit 0; fi; \
	if [ "$(ASTA_DEFAULT_RELEASE)" = 1 ] && [ -n "$(ASTA_FALLBACK_RELEASE)" ] && [ -s '$(ASTA_CACHE_ROOT)/$(ASTA_FALLBACK_RELEASE)/workspace.mk' ]; then \
		mkdir -p "$$(dirname "$@")"; \
		printf '# asta-fallback\noverride ASTA_PLUGINS_REF := %s\ninclude %s\n' \
			'$(ASTA_FALLBACK_RELEASE)' \
			'$(ASTA_CACHE_ROOT)/$(ASTA_FALLBACK_RELEASE)/workspace.mk' > "$$tmp/fallback.mk"; \
		mv "$$tmp/fallback.mk" "$@"; \
		echo "workspace: $$failure; using cached release $(ASTA_FALLBACK_RELEASE)" >&2; exit 0; \
	fi; \
	echo "$$failure" >&2; exit 1
endif
endif
