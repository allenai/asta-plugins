{
  "name": "Asta",
  "image": "ghcr.io/allenai/asta:latest",
  "runArgs": [
    "--env",
    "ASTA_TOKEN"
  ],
  "secrets": {
    "ASTA_TOKEN": {
      "description": "Asta API token used by the asta CLI and skills.",
      "documentationUrl": "https://github.com/allenai/asta-plugins#readme"
    }
  },
  "postCreateCommand": "npx --yes skills@latest add /opt/asta-plugins --all -g --yes",
  "postAttachCommand": {
    "preview": "curl -s -o /dev/null http://127.0.0.1:4848/ || { [ -f Makefile ] && make preview; } || { [ -f _quarto.yml ] && quarto preview --no-browser; } || true"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "james-yu.latex-workshop"
      ]
    }
  },
  "forwardPorts": [
    4848
  ],
  "portsAttributes": {
    "4848": {
      "label": "Quarto Preview",
      "onAutoForward": "openPreview"
    }
  }
}
