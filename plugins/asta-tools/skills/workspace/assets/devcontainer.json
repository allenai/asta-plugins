{
  "name": "Asta",
  "image": "ghcr.io/allenai/asta:latest",
  "runArgs": [
    "--env",
    "ASTA_TOKEN"
  ],
  "secrets": {
    "ASTA_TOKEN": {
      "description": "Optional Asta API token for the asta CLI and skills; leave blank and run `asta auth login` instead.",
      "documentationUrl": "https://github.com/allenai/asta-plugins#readme"
    }
  },
  "postCreateCommand": "npx --yes skills@latest add /opt/asta-plugins --all -g --yes",
  "postAttachCommand": {
    "preview": "exec asta workspace preview"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto"
      ]
    }
  },
  "forwardPorts": [
    4848
  ],
  "portsAttributes": {
    "4848": {
      "label": "Quarto Preview",
      "onAutoForward": "notify"
    }
  }
}
