# Quarto build artifacts (the workspace skill appends any of these lines
# missing from the project's .gitignore).
_site/
quarto-render.*

# Managed extensions, fetched by the scaffold rules.
_extensions/

# LaTeX build artifacts
paper/build/
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
# The paper preview's temporary latexdiff source.
paper/what-changed.tex

/.quarto/
# Quarto adds this on render; listed here so that a render leaves the checkout clean.
**/*.quarto_ipynb

# CLI-managed workspace rules and archive
.asta/cache/

__pycache__/

# Generated paper viewer; commit a copy only to customize it.
/paper/html/index.qmd
/paper/html/paper-viewer.js
# Generated slide viewer pages; commit a copy only to customize it.
/slides/attention/index.qmd
